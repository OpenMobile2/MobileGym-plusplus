      "preview": {
        "kind": "code",
        "title": "移动项目测试 bert 可行性.ipynb",
        "lines": [
          "# 移动项目：BERT 可行性验证",
          "import torch",
          "from transformers import AutoTokenizer, AutoModel",
          "",
          "tok = AutoTokenizer.from_pretrained(\"bert-base-chinese\")",
          "model = AutoModel.from_pretrained(\"bert-base-chinese\")",
          "",
          "# 端上推理的显存与延迟基线",
          "x = tok(\"移动端能否直接跑 BERT\", return_tensors=\"pt\")",
          "with torch.no_grad():",
          "    out = model(**x)",
          "print(out.last_hidden_state.shape)  # torch.Size([1, 12, 768])",
          "",
          "# 结论：fp32 下单条约 180ms，量化到 int8 后约 70ms，可接受"
        ]
      }
    },
